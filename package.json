{
  "name": "marp-slides-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Marp slide studio with color themes, layout patterns, and AI agent workflows",
  "license": "MIT",
  "author": "unsolublesugar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unsolublesugar/marp-slides-studio.git"
  },
  "keywords": [
    "marp",
    "marp-cli",
    "slides",
    "presentation",
