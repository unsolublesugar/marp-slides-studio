node_modules/
.DS_Store

# Claude Code のローカル設定（ユーザー固有）
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 公開リポジトリに私物スライドを誤pushしないよう、見本デッキ以外は無視する。
# テンプレートから作った自分のリポジトリでは、次の2行を削除してデッキをコミットする
slides/*
!slides/20260101-sample-deck/

# レイアウト検証用のスライド画像（成果物はhtml/pdfのみコミット）
slides/*/png/
template/png/

# 描画確認用のスクラッチデッキ
slides/_pdftest/

# README用スクショ生成の作業ディレクトリ
.docs-shot/

# テーマギャラリーの生成物
.gallery/

# デッキのテーマ切替プレビューの生成物
slides/*/.theme-preview/
